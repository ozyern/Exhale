<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Exhale" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Pure black under the first frame so cold start never flashes white before the
             Compose BootSplash layer composes — the system splash, the window and the
             Compose splash are all the same color, reading as ONE seamless boot screen. -->
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Android 12+ SplashScreen API (minSdk 33): a bare black canvas, no icon.
             The system window is only here to cover the gap before Compose can draw; the
             *visible* splash is BootSplash. Drawing the mark here too meant every cold start
             showed the logo twice — system splash, then our animated one — which reads as the
             app launching, stopping and launching again. See @drawable/splash_icon_none for
             why an empty drawable is needed rather than simply omitting the attribute. -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
