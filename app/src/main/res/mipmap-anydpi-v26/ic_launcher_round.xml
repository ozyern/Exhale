<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Round variant of the brand launcher mark. Same safe-zone-inset Exhale glass "E))"
         (assets/icon.png via @drawable/ic_launcher_foreground_inset) as the standard adaptive
         icon foreground; NOT the splash logo. The circular mask is the harshest crop of the
         lot, so the inset matters most here. -->
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_inset" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
