<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brand launcher mark: the Exhale glass "E))" (assets/icon.png), used exclusively for the
         home-screen / app-drawer adaptive icon foreground. Its own dark radial backdrop is baked
         in, so it sits over the black background layer seamlessly.
         The foreground goes through @drawable/ic_launcher_foreground_inset, NOT the raw PNG —
         the inset pulls the artwork back into the 72dp safe zone so the launcher's mask can no
         longer clip the mark's outer strokes. See that file for the arithmetic.
         NOTE: this is a distinct asset from the splash animation logo (@drawable/splash_logo) —
         do not conflate them. -->
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_inset" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>