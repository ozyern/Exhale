<?xml version="1.0" encoding="utf-8"?>
<!--
    A deliberately empty splash icon.

    Android 12+ ALWAYS draws something in the system splash window: name no
    `windowSplashScreenAnimatedIcon` and it falls back to the launcher icon. So the only way to
    have the system splash show nothing is to hand it a fully transparent drawable.

    Why we want nothing: the app used to show the mark twice on every cold start — once in the
    system splash (static, centred, system-masked) and again a frame later in the Compose
    BootSplash (animated, gold bloom, iris exit). Two logos back to back reads as the app starting
    twice. The system window now paints only `splash_background`, which is the same black the
    Compose splash paints, so the hand-off between them is invisible and the animated one is the
    only splash anybody sees.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
